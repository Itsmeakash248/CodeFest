# Copy to .env.local. All keys are server-side only.
# The app works with zero keys: the local rubric engine is the default.

# AI (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# OpenRouter fallback requires credits on the account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Voice (optional; browser speech is the fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Auth (demo cookie session default; Supabase cloud optional)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional robot bridge (LAN only, unauthenticated)
# ROBOT_BASE_URL=http://192.168.1.42

# Demo speed
# WORKFLOW_FAST=0
