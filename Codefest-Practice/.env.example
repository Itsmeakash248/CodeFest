# ViewPilot environment — every variable is optional.
# With none of these set, the full interview and report still work
# through the deterministic local rubric engine.

# ------------------------------------------------------------------
# Optional AI layer (server-side only — never prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=            # accepted alias for GEMINI_API_KEY
# GOOGLE_GENERATIVE_AI_API_KEY=

# ------------------------------------------------------------------
# Optional robot backup interviewer (ESP32-S3, LAN only)
# ------------------------------------------------------------------
# ROBOT_BASE_URL=http://192.168.1.42
